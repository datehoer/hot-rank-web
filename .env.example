# 阿里云内容安全（Green 2022-03-02）凭证示例
# 复制为 .env 并填入真实值；.env 已被 .gitignore 忽略，请勿提交真实密钥。
ALIBABA_CLOUD_ACCESS_KEY_ID=your-access-key-id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your-access-key-secret

# 本地关键词过滤词表（逗号分隔）。
# 真实敏感词仅保存在本地 .env 中，不入库、不出现在公开仓库。
# 示例（占位符，非真实词表）：
HOTRANK_HARD_BLOCK_TERMS=示例硬拦截词1,示例硬拦截词2
HOTRANK_POLITICAL_KEYWORDS=示例政治域关键词1,示例政治域关键词2

# Umami 服务端事件统计（Agent 用量与防护拦截计数，均为可选，默认已启用）
# UMAMI_ANALYTICS_ENABLED=true
# UMAMI_ENDPOINT=https://umami.datehoer.com
# UMAMI_WEBSITE_ID=89135d8e-bd6e-43f7-8a2e-5e60a64db4de
# UMAMI_HOSTNAME=www.hotday.uk
# UMAMI_TIMEOUT_SECONDS=5
